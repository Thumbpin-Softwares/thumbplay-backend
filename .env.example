# Server
PORT=5000
NODE_ENV=development

# This backend's own publicly-reachable base URL — e.g. https://api.thumbpin.in
# in production, or left unset for local dev (defaults to http://localhost:$PORT).
# Single source of truth: GOOGLE_CALLBACK_URL and the Swagger "servers" entry
# both derive from this unless explicitly overridden below. Update this ONE
# var whenever the backend's domain changes instead of hunting down every
# place that used to hardcode it.
BACKEND_PUBLIC_URL=http://localhost:5000

# Same MongoDB database as thumbpinclient — copy the exact value from
# thumbpinclient/.env.local (MONGODB_URI) so the shared User collection stays consistent.
MONGODB_URI=

# Plain JWT secrets signed by this backend — NOT the same as thumbpinclient's
# NEXTAUTH_SECRET (that one encrypts a JWE, not compatible with plain JWT signing).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Separate secret for admin tokens (defense in depth).
JWT_ADMIN_SECRET=

# Google OAuth — can reuse the same values already in thumbpinclient/.env.local
# (same Google Cloud OAuth client), but you must add this backend's callback URL
# ({BACKEND_PUBLIC_URL}/api/v1/auth/google/callback) to that client's
# "Authorized redirect URIs" in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — derived from BACKEND_PUBLIC_URL by default. Only set this if the
# OAuth callback needs to be reachable at a different URL than the backend's
# own public URL.
# GOOGLE_CALLBACK_URL=

# Used for CORS origin (credentials:true requires an explicit origin) and the
# post-OAuth redirect target.
FRONTEND_URL=http://localhost:3000

# Admin login — bcrypt hash only, no plaintext fallback.
# Generate a hash with: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Reel pipelines (seedance-reel/action-reel/comedy-reel) — copy real values
# from thumbpinclient/.env.local. FAL_KEY covers Seedance video generation,
# the script-splitting LLM (via fal's openrouter/router proxy), and ElevenLabs
# TTS (via fal's proxy). SARVAM_API_KEY is a direct, non-fal TTS provider.
FAL_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
SARVAM_API_KEY=
