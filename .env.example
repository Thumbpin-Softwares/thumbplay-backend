# Server
PORT=5000
NODE_ENV=development

# This backend's own publicly-reachable base URL - e.g. https://api.thumbpin.in
# in production, or left unset for local dev (defaults to http://localhost:$PORT).
# Single source of truth: GOOGLE_CALLBACK_URL and the Swagger "servers" entry
# both derive from this unless explicitly overridden below. Update this ONE
# var whenever the backend's domain changes instead of hunting down every
# place that used to hardcode it.
BACKEND_PUBLIC_URL=http://localhost:5000

# Same MongoDB database as thumbpinclient - copy the exact value from
# thumbpinclient/.env.local (MONGODB_URI) so the shared User collection stays consistent.
MONGODB_URI=

# Plain JWT secrets signed by this backend - NOT the same as thumbpinclient's
# NEXTAUTH_SECRET (that one encrypts a JWE, not compatible with plain JWT signing).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Separate secret for admin tokens (defense in depth).
JWT_ADMIN_SECRET=

# Google OAuth - can reuse the same values already in thumbpinclient/.env.local
# (same Google Cloud OAuth client), but you must add this backend's callback URL
# ({BACKEND_PUBLIC_URL}/api/v1/auth/google/callback) to that client's
# "Authorized redirect URIs" in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional - derived from BACKEND_PUBLIC_URL by default. Only set this if the
# OAuth callback needs to be reachable at a different URL than the backend's
# own public URL.
# GOOGLE_CALLBACK_URL=

# Comma-separated allow-list (no spaces around the comma) - used for CORS
# origin (credentials:true requires an explicit origin) and the post-OAuth
# redirect target (always the first entry, since Google's callback has no
# Origin header to route by).
FRONTEND_URL=http://localhost:3000,https://ai.thumbpin.in

# Admin login - bcrypt hash only, no plaintext fallback.
# Generate a hash with: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Reel pipelines (seedance-reel/action-reel/comedy-reel) - copy real values
# from thumbpinclient/.env.local. FAL_KEY covers Seedance video generation,
# the script-splitting LLM (via fal's openrouter/router proxy), and ElevenLabs
# TTS (via fal's proxy). SARVAM_API_KEY is a direct, non-fal TTS provider.
FAL_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
SARVAM_API_KEY=

# n8n splitter/voice-change workflow. Use the production /webhook URL for
# staging/prod. /webhook-test only works once after manually clicking
# "Execute workflow" in n8n.
N8N_SPLITTER_WEBHOOK_URL=https://wrk-413d.apps.excloud.co.in/webhook/366dbdd2-7128-4265-9e91-55cdf8c9daf2

# Razorpay payment gateway
# All three are optional - if unset, createOrder() returns a mock order so you
# can test the full UI flow without a real Razorpay account.
#
# HOW TO GET THESE:
#  1. Sign up / log in at https://dashboard.razorpay.com
#  2. Settings → API Keys → Generate Test Key
#     → copy Key ID (starts with rzp_test_) into RAZORPAY_KEY_ID
#     → copy Key Secret into RAZORPAY_KEY_SECRET
#  3. Settings → Webhooks → Add New Webhook
#     → URL: https://your-backend-url/api/v1/payments/webhook
#     → Events: tick "payment.captured"
#     → copy the Secret into RAZORPAY_WEBHOOK_SECRET
#
# For local dev use: ngrok http 5000  →  copy the https URL as the webhook URL
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OpenAI - the one direct (non-fal.ai, non-n8n) model call in this backend.
# Powers agent-chat's conversational tool-calling + streaming, which fal.ai's
# openrouter/router wrapper can't do (no messages array, no tools, no
# streaming - see reel/llm.service.ts for how that one's used instead).
# Optional - if unset, agent-chat's conversation-start endpoint returns a
# clean 503 rather than the backend failing to boot.
#   1. Get a key from https://platform.openai.com/api-keys
#   2. Confirm/update OPENAI_MODEL against OpenAI's current model lineup -
#      the default below is a reasonable-as-of-writing pick, not verified-current.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

